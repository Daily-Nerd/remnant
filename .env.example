# LLM backend — defaults to homelab LiteLLM proxy
LLM_BASE_URL=http://litellm.litellm.svc.cluster.local:4000
LLM_API_KEY=your-key-here
LLM_MODEL=gpt-4o-mini

# Embedding model (sentence-transformers, runs locally)
EMBED_MODEL=all-MiniLM-L6-v2

# Data storage
REMNANT_DATA_DIR=./data

# Optional: NCBI API key for higher PubMed rate limits
NCBI_API_KEY=

# Optional: GitHub token for GitHub Issues ingestion
GITHUB_TOKEN=

# Tuning
DECAY_ALERT_THRESHOLD=0.65
COLLISION_SIMILARITY_THRESHOLD=0.72
